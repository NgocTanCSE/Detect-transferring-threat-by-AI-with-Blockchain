# Blockchain Sentinel Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real API keys to git.

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=blockchain
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=blockchain_main
DATABASE_URL=sqlite:///blockchain_local.db
# DATABASE_URL=postgresql://blockchain:${POSTGRES_PASSWORD}@postgres_main:5432/blockchain_main

# ============================================
# DOCKER SERVICE CREDENTIALS
# ============================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change_this_to_a_strong_password
GRAFANA_ADMIN_PASSWORD=change_this_to_a_strong_password
ELASTIC_PASSWORD=change_this_to_a_strong_password

# ============================================
# API KEYS (Required for real blockchain data)
# ============================================
# Alchemy: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here
# Etherscan: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# AI / LLM CONFIGURATION
# ============================================
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1
GEMINI_REQUEST_TIMEOUT_SECONDS=10
# Hugging Face token (legacy fallback)
HF_TOKEN=

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_in_production
AUTH_DISABLED=false

# ============================================
# REGISTRATION & LOGIN SECURITY
# ============================================
REGISTRATION_RATE_LIMIT=3
REGISTRATION_WINDOW_SECONDS=3600
MIN_REGISTRATION_INTERVAL=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ============================================
# REDIS CACHING
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# SERVICE URLs (for microservice communication)
# ============================================
ALERT_SERVICE_URL=http://alert-service:3003
ANALYTICS_SERVICE_URL=http://analytics-service:3005

# ============================================
# BACKEND CONFIGURATION
# ============================================
BACKEND_API_URL=http://backend:8000
AI_MODEL_VERSION=v1.0

# ============================================
# DEMO / SEED DATA
# ============================================
DEMO_FUNDED_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
DEMO_INITIAL_BALANCE_ETH=1000

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SENDER_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# ============================================
# SCANNER CONFIGURATION
# ============================================
SCAN_INTERVAL=30
BLOCK_THRESHOLD=80
WARNING_THRESHOLD=50
MAX_WARNINGS=3
RESET_DB=0

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
DEBUG=False
LOG_LEVEL=INFO
LOG_FORMAT=text
