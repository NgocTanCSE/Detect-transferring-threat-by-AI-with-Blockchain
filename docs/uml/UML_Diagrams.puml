' =============================================================================
' 4. ENTITY RELATIONSHIP DIAGRAM (ERD)
' =============================================================================
@startuml entity-relationship-diagram
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 10
skinparam roundCorner 6
skinparam shadowing false
skinparam linetype ortho
skinparam classFontSize 10
skinparam classAttributeFontSize 9

title Entity Relationship Diagram (ERD) - PostgreSQL Schema (Partitioned)

package "Tenancy & User Management" #EFF6FF {
  class Organization {
    + String id [PK]
    + String name
    + String slug [Unique]
    + String plan [STARTER, PRO, ENTERPRISE]
    + Boolean is_active
    + DateTime created_at
  }

  class User {
    + String id [PK]
    + String organization_id [FK]
    + String email [Unique]
    + String hashed_password
    + String role [ADMIN, ANALYST, AUDITOR]
    + Boolean is_active
  }
}

package "Blockchain Ledger (Partitioned by Month)" #ECFDF5 {
  class Wallet {
    + String address [PK]
    + String organization_id [FK]
    + String chain_id [ETH, POLYGON, ARB]
    + String label
    + Float risk_score
    + Boolean is_monitored
    + DateTime first_seen
  }

  class Transaction {
    + String tx_hash [PK]
    + DateTime block_timestamp [PK, Partition Key]
    + String organization_id [FK]
    + String chain_id
    + String from_address [FK]
    + String to_address [FK]
    + Decimal value_eth
    + Decimal gas_price_gwei
    + Boolean is_flagged
  }
  note right: Table partitioned monthly\n(tx_2026_01, tx_2026_02, etc.)

  class TokenTransfer {
    + String id [PK]
    + String tx_hash [FK]
    + String token_address
    + String token_symbol
    + Decimal amount
  }
}

package "Threat Intelligence & Security Alerts" #FFF7ED {
  class RiskAssessment {
    + String id [PK]
    + String tx_hash [FK]
    + Float risk_score
    + String risk_level [LOW, MED, HIGH, CRITICAL]
    + Json feature_vector
    + Json explanation
    + DateTime evaluated_at
  }

  class Alert {
    + String id [PK]
    + String organization_id [FK]
    + String tx_hash [FK]
    + String title
    + String severity [LOW, MEDIUM, HIGH, CRITICAL]
    + String status [NEW, INVESTIGATING, RESOLVED, FALSE_POSITIVE]
    + String assigned_to_user_id [FK]
    + DateTime created_at
  }

  class Blacklist {
    + String address [PK]
    + String reason [TORNADO_CASH, PHISHING, RANSOMWARE]
    + String source [OFAC, INTERNAL, CHAINALYSIS]
    + Boolean is_active
    + DateTime added_at
  }

  class BlockedTransfer {
    + String id [PK]
    + String tx_hash [FK]
    + String rule_triggered
    + Decimal blocked_amount
    + DateTime intercepted_at
  }
}

package "Governance & Investigation Cases" #FEFCE8 {
  class TransactionCase {
    + String id [PK]
    + String organization_id [FK]
    + String title
    + String status [OPEN, IN_REVIEW, CLOSED]
    + String lead_analyst_id [FK]
    + Json evidence_notes
    + DateTime created_at
  }

  class FeedbackLabel {
    + String id [PK]
    + String tx_hash [FK]
    + String analyst_id [FK]
    + String true_label [THREAT, BENIGN]
    + String notes
    + DateTime submitted_at
  }

  class PolicyRule {
    + String id [PK]
    + String organization_id [FK]
    + String rule_name
    + String condition_expression
    + String action [FLAG, BLOCK, ALERT]
    + Boolean is_enabled
  }

  class AuditLog {
    + String id [PK]
    + String user_id [FK]
    + String action
    + String target_entity
    + DateTime timestamp
  }
}

Organization ||--o{ User : "members"
Organization ||--o{ Wallet : "monitors"
Organization ||--o{ Alert : "receives"
Organization ||--o{ TransactionCase : "opens"
Organization ||--o{ PolicyRule : "configures"

Wallet ||--o{ Transaction : "sends / receives"
Transaction ||--o{ TokenTransfer : "contains"
Transaction ||--o| RiskAssessment : "evaluated by"
Transaction ||--o{ Alert : "triggers"
Transaction ||--o| BlockedTransfer : "intercepted"

Alert }o--|| User : "assigned to"
TransactionCase }o--|| User : "led by"
FeedbackLabel }o--|| Transaction : "labels"
FeedbackLabel }o--|| User : "provided by"
@enduml

