' =============================================================================
' 2. MICROSERVICES & RABBITMQ EVENT ARCHITECTURE
' =============================================================================
@startuml microservices-event-architecture
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam linetype ortho

title Microservices Event-Driven Mesh & Circuit Breaker Architecture

package "API Gateway Core (Port: 8001)" #F8FAFC {
  component "Incoming Request Handler\n• Injects 'x-correlation-id'\n• Validates JWT Bearer Token" as GW_CORE #EFF6FF

  component "Opossum Circuit Breakers" as CB_GROUP #EFF6FF {
    component "Auth CB" as CB_AUTH #FFFFFF
    component "AI CB" as CB_AI #FFFFFF
    component "Alert CB" as CB_ALERT #FFFFFF
    component "Transfer CB" as CB_TRANSFER #FFFFFF
  }
}

package "RabbitMQ Topic Exchanges" #FEE2E2 {
  queue "Exchange: 'blockchain.tx.exchange'\n• Routing Key: 'tx.incoming'" as EX_TX
  queue "Exchange: 'threat.alert.exchange'\n• Routing Key: 'threat.high', 'threat.critical'" as EX_ALERT
  queue "Dead Letter Exchange (DLQ)\n• Captures failed event processing" as EX_DLQ
}

package "Domain Consumer Workers" #FFFFFF {
  component "AI Risk Classifier Worker\n• Evaluates ML feature vector\n• Fast heuristic blacklist lookup" as WORKER_AI #FFF7ED
  component "Alert Dispatcher Worker\n• Persists Alert to Database\n• Sends PagerDuty / Webhook" as WORKER_ALERT #EFF6FF
  component "Compliance AML Worker\n• Checks OFAC sanctions lists\n• Freezes suspicious transfers" as WORKER_COMPLIANCE #EFF6FF
  component "WebSocket Broadcaster\n• Emits event to connected browsers" as WORKER_WS #EFF6FF
}

GW_CORE --> CB_AUTH : Forward
GW_CORE --> CB_AI : Forward
GW_CORE --> CB_ALERT : Forward
GW_CORE --> CB_TRANSFER : Forward

EX_TX --> WORKER_AI : Consume 'tx.incoming'
WORKER_AI --> EX_ALERT : Publish if RiskScore > 0.75
WORKER_AI ..> EX_DLQ : On parsing failure

EX_ALERT --> WORKER_ALERT : Process Incident
EX_ALERT --> WORKER_COMPLIANCE : Evaluate AML Block
EX_ALERT --> WORKER_WS : Push to Security Dashboard
@enduml

