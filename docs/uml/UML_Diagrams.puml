title Container Diagram - Blockchain AI Sentinel Platform (C4 Level 2)

package "Presentation Layer" as CLIENT_LAYER #FAFAFA {
  component "Security Analyst Dashboard\n[Next.js 14, React 18, TypeScript, Tailwind]\n• Live Threat Map, Case Management, Chat\n• Port: 3000" as WEB_UI #FEFCE8
}

package "API Gateway & Edge Proxy" as GATEWAY_LAYER #F1F5F9 {
  component "API Gateway\n[Node.js, Express]\n• JWT & API Key Auth, Rate Limiter\n• Opossum Circuit Breakers & Request Tracing\n• Port: 8001" as API_GW #EFF6FF
}

package "Microservices Ecosystem" as SERVICES_LAYER #FFFFFF {
  component "Auth Service\n[Express, Port: 3001]\n• User Sessions & Multi-tenant Orgs" as AUTH_SVC #EFF6FF
  component "Wallet Service\n[Express, Port: 3002]\n• Monitored Wallets & Balance Sync" as WALLET_SVC #EFF6FF
  component "Alert Service\n[Express, Port: 3003]\n• Incident Lifecycle & Pager Alerts" as ALERT_SVC #EFF6FF
  component "Transfer Service\n[Express, Port: 3004]\n• Crypto Transfers & Policy Enforcement" as TRANSFER_SVC #EFF6FF
  component "Analytics Service\n[Express, Port: 3005]\n• Threat Aggregation & Money Flow" as ANALYTICS_SVC #EFF6FF
  component "Compliance Service\n[Express, Port: 3006]\n• AML Rule Engine & Blacklist Checks" as COMPLIANCE_SVC #EFF6FF
  component "Event Service\n[Express + Socket.IO, Port: 3007]\n• Real-Time WebSocket Push to Frontend" as EVENT_SVC #EFF6FF
}

package "AI Intelligence & Autonomous Ingestion" as AI_LAYER #FFF7ED {
  component "AI Engine Microservice\n[FastAPI, Python 3.11, Port: 8000]\n• Multi-Agent Risk Classifier (RF / XGBoost)\n• Gemini 1.5/2.0 Assistant & Knowledge Base\n• Continuous Retraining Pipeline" as AI_SVC #FED7AA

  component "Autonomous Chain Scanner\n[Python Daemon Worker]\n• Continuous Mempool & Block Monitoring\n• Feature Extraction & Event Publisher" as SCANNER #FED7AA
}

package "Persistence & Message Broker" as DATA_LAYER #F8FAFC {
  database "PostgreSQL 16 Database\n• Monthly Partitioned 'transactions' Table\n• 26 Tables (Wallets, Alerts, Cases, Models)\n• Port: 5432" as POSTGRES #E8F0FE

  queue "RabbitMQ 3.12 Message Broker\n• Exchanges: 'blockchain.events', 'alerts'\n• Queues with Dead Letter Exchanges (DLQ)\n• Port: 5672 (Admin: 15672)" as RABBITMQ #FEE2E2

  queue "Redis 7 In-Memory Store\n• Rate Limit Counters & Token Cache\n• Port: 6379" as REDIS #FEE2E2
}

package "External Blockchain Networks & AI" as EXT_SVCS #FEF7E0 {
  cloud "Alchemy Web3 RPC Gateway\n(Ethereum, Polygon, Arbitrum Nodes)" as ALCHEMY_API
  cloud "Google Gemini Generative AI\n(Natural Language Threat Copilot)" as GEMINI_API
}

