' =============================================================================
' 8. SEQUENCE: REAL-TIME THREAT SCANNING & ALERT BROADCAST
' =============================================================================
@startuml seq-realtime-threat-scan
!theme plain
autonumber
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

title Sequence: Autonomous Scanner Threat Detection & Real-Time Alert Broadcast

participant "Alchemy Web3 RPC" as ALCHEMY #FEF7E0
participant "Autonomous Scanner" as SCANNER #FFF7ED
queue "RabbitMQ ('blockchain.tx')" as RMQ_TX #FEE2E2
participant "FastAPI AI Service" as AI #FFF7ED
database "PostgreSQL DB" as DB #E8F0FE
queue "RabbitMQ ('threat.alert')" as RMQ_ALERT #FEE2E2
participant "Alert Service (:3003)" as ALERT_SVC #EFF6FF
participant "Event Service (:3007)" as EVENT_SVC #EFF6FF
participant "Next.js Dashboard" as FE #FEFCE8

SCANNER -> ALCHEMY: eth_getBlockByNumber("latest", true)
ALCHEMY --> SCANNER: Return Block with 120 Transactions

SCANNER -> SCANNER: Extract transactions touching monitored contracts
SCANNER -> RMQ_TX: Publish 'tx.scanned' { txHash, from, to, value, gasPrice }

RMQ_TX -> AI: Consume 'tx.scanned' event
activate AI
AI -> DB: Check address against 'blacklist' table
alt Address Found in Blacklist
  AI -> AI: Immediate RiskScore = 1.0 (Flagged: BLACKLIST_MATCH)
else Address Clean
  AI -> AI: Compute 32 ML Graph & Behavioral Features
  AI -> AI: Model Inference (RandomForest Classifier) -> Probability: 0.92
